generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  Id               String       @id @default(uuid())
  Name             String
  Email            String       @unique
  Phone            String       @unique
  Role             Role
  Password_Hash    String
  RefreshToken     String?
  student          Student?
  passActions      PassAction[]
  caretakerHostels Hostel?      @relation("CaretakerRelation")
  wardenHostels    Hostel?      @relation("WardenRelation")
  blockeds         Blocked[]
  passwordResetTokens PasswordResetToken[]
}

model Student {
  Roll_No            String    @id
  User_Id            String    @unique
  Block_Id           String
  Is_Blocked         Boolean   @default(false)
  DEFAULTER_Attempts Int       @default(0)
  PARENT_MAIL        String
  PARENT_NAME        String
  ADDRESS            String
  PARENT_PHONE       String
  Photo_Url          String    @default("https://ui-avatars.com/api/?background=0D1B2A&color=FFE38A&size=256&bold=true&name=Student")
  Passes             Pass[]
  blocked            Blocked[]
  user               User      @relation(fields: [User_Id], references: [Id])
  hostel             Hostel    @relation(fields: [Block_Id], references: [Block_Id])
}

model Hostel {
  Block_Id     String    @id
  CareTaker_Id String    @unique
  Warden_Id    String    @unique
  Students     Student[]
  blocked      Blocked[]
  caretaker    User      @relation("CaretakerRelation", fields: [CareTaker_Id], references: [Id])
  warden       User      @relation("WardenRelation", fields: [Warden_Id], references: [Id])
}

model Pass {
  passID             String       @id @default(uuid())
  RollNo             String
  passType           PassType
  RaisedAt           DateTime     @default(now())
  Destination        String
  Purpose            String
  ModeofTransport    String
  QRCODE             String       @unique
  Status             PassStatus   @default(PENDING)
  Expected_Date      String
  Expected_Time      String
  Actual_Return_Date String?
  Actual_Return_Time String?
  actions            PassAction[]
  student            Student      @relation(fields: [RollNo], references: [Roll_No])
  @@index([RollNo])
}

model PassAction {
  Action_Id   String   @id @default(uuid())
  passID      String
  Actor_Id    String?
  Action_Type String
  Remarks     String?
  Timestamp   DateTime @default(now())
  pass        Pass     @relation(fields: [passID], references: [passID])
  actor       User?    @relation(fields: [Actor_Id], references: [Id])
}

model ParentApprovalToken {
  id        String    @id @default(uuid())
  passId    String    @unique
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [Id])
}

model Blocked {
  id              String    @id @default(uuid())
  Roll_No         String
  Hostel_id       String
  Blocked_Role_ID String
  BlockedAt       DateTime  @default(now())
  UnblockedAt     DateTime?
  student         Student   @relation(fields: [Roll_No], references: [Roll_No])
  hostel          Hostel    @relation(fields: [Hostel_id], references: [Block_Id])
  blockedBy       User      @relation(fields: [Blocked_Role_ID], references: [Id])
}

enum PassType {
  DAY_PASS
  HOME_PASS
}

enum PassStatus {
  PENDING
  CANCELLED
  Parentapproved
  CareTakerapproved
  CHECKEDIN
  CHECKEDOUT
}

enum Role {
  STUDENT
  CARETAKER
  WARDEN
  PARENT
  SECURITY
}

